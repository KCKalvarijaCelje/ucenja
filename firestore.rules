rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Teachers Collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true;
    }

    // Teachings Collection
    match /teachings/{teachingId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings Configuration
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if true;
    }

    // Pending Imports Queue
    match /pending_imports/{importId} {
      allow read: if true;
      allow write: if true;
    }

    // New Structured Import Items Queue
    match /import_items/{importId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Authorized Users
    match /admin_users/{email} {
      allow read: if true;
      allow write: if true;
    }
  }
}
