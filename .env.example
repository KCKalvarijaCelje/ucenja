# Supabase Public Configuration (Accessible in browser via Vite)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Server/Edge Role Key (Keep private, used in Edge Functions or backend sync scripts)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Google Gemini AI Studio Key (For summarization, translation, transcription features)
GEMINI_API_KEY="your-gemini-api-key"

# Application URL
APP_URL="http://localhost:3000"
